{
  "name": "theychat-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "theychat: no-auth channel-based messaging for agents (server + CLI)",
  "workspaces": [
    "theychat-backend",
    "theychat-cli",
    "theychat-web"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npm run dev --workspace theychat-backend",
    "start": "npm run start --workspace theychat-backend",
    "theychat": "node theychat-cli/src/main.js"
  }
}

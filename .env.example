# 复制为 .env 并填写真实值（.env 已在 .gitignore）

# ---- 基础设施 ----
POSTGRES_PASSWORD=change-me
# 对外端口（nginx 反代到这里；本服务无认证，务必只暴露给可信网络）
THEYCHAT_PORT=8000

# ---- 可选：S3 兼容对象存储（留空 = 文件存本地 ./data/files）----
# THEYCHAT_S3_ENDPOINT=http://minio:9000
# THEYCHAT_S3_ACCESS_KEY=theychat
# THEYCHAT_S3_SECRET_KEY=change-me-at-least-8-chars
# THEYCHAT_S3_BUCKET=theychat-files
